      "parameters": {
        "jsCode": "// Accept the attempt id from the body OR the query string; refuse to forward anything missing,\n// malformed or contradictory. Server-side binding is unchanged.\nconst raw = $json.body || $json;\nconst body = (raw && typeof raw === 'object') ? raw : {};\nconst query = ($json.query && typeof $json.query === 'object') ? $json.query : {};\nconst has = (v) => v !== undefined && v !== null && String(v).trim() !== '';\nconst bodyId = has(body.attemptId) ? String(body.attemptId).trim() : null;\nconst queryId = has(query.attemptId) ? String(query.attemptId).trim() : null;\n\nif (bodyId && queryId && bodyId !== queryId) {\n  return [{ json: { ok: false, status: 400, error: 'CONFLICTING_ATTEMPT_ID' } }];\n}\nconst attemptId = bodyId || queryId;\nif (!attemptId || !/^att_[a-f0-9]{24}$/.test(attemptId)) {\n  return [{ json: { ok: false, status: 400, error: 'MALFORMED' } }];\n}\nreturn [{ json: {\n  ok: true,\n  timestamp: String(Math.floor(Date.now() / 1000)),\n  body: Object.assign({}, body, { attemptId })\n} }];"
      },
      "id": "vt-sign",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pass the server's JSON through unchanged when it succeeded; otherwise give Rosina a\n// line that is honest about the answer not being recorded.\nconst FAILED = \"Thank you. I couldn't confirm your answer was recorded. If this is time-sensitive, please contact the family directly.\";\nconst r = $json || {};\nconst status = Number(r.statusCode || 0);\nlet payload = r.body;\nif (typeof payload === 'string') { try { payload = JSON.parse(payload) } catch { payload = null } }\nif (status >= 200 && status < 300 && payload && typeof payload.say === 'string') {\n  return [{ json: payload }];\n}\nreturn [{ json: { status: 'FAILED', note: 'voice_turn_unavailable', say: FAILED } }];"
      },
