    {
      "id": "fg-sign-reply",
      "name": "Sign reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        240
      ],
      "notes": "webhook.md \u00a73a: hex HMAC-SHA256 of `${timestamp}.${rawBody}` with N8N_WEBHOOK_SECRET from the environment. eventId is stable per attempt+decision so a retry is an idempotent duplicate, not a second write.",
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = 'UNSET' + '_SESSION_2B';\nif (!secret) throw new Error('FRIDGEGRAPH_WEBHOOK_SECRET missing');\nconst j = $json;\nconst body = {\n  eventId: 'ghl-' + j.attemptId + '-' + j.decision,\n  attemptId: j.attemptId,\n  requestVersion: Number(j.requestVersion),\n  available: j.decision === 'ACCEPTED',\n  declineReason: j.decision === 'ACCEPTED' ? null : (j.declineReason || 'OTHER'),\n  recipient: j.recipient,\n  channel: j.channel\n};\nconst raw = JSON.stringify(body);\nconst ts = String(Math.floor(Date.now() / 1000));\nconst signature = crypto.createHmac('sha256', secret).update(ts + '.' + raw).digest('hex');\nreturn [{ json: { raw, ts, signature, body } }];"
      }
    },
    {
      "id": "fg-sign-timeout",
      "name": "Sign no-answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        460
      ],
      "notes": "A no-answer becomes the same UNAVAILABLE outcome the discovery window would produce. It never claims the person declined.",
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = 'UNSET' + '_SESSION_2B';\nif (!secret) throw new Error('FRIDGEGRAPH_WEBHOOK_SECRET missing');\nconst j = $json;\nconst body = {\n  eventId: 'ghl-timeout-' + j.attemptId,\n  attemptId: j.attemptId,\n  requestVersion: Number(j.requestVersion),\n  available: false,\n  declineReason: 'OTHER',\n  recipient: j.recipient,\n  channel: j.channel\n};\nconst raw = JSON.stringify(body);\nconst ts = String(Math.floor(Date.now() / 1000));\nconst signature = crypto.createHmac('sha256', secret).update(ts + '.' + raw).digest('hex');\nreturn [{ json: { raw, ts, signature, body } }];"
      }
    },
    {
      "id": "fg-post-reply",
      "name": "FridgeGraph Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        340,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "https://UNSET_SESSION_2B/webhooks/coordination/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-FridgeGraph-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-FridgeGraph-Signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw }}",
        "options": {
          "timeout": 5000,
          "response": {
            "neverError": true
          }
        }
      }
    },
