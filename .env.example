META_API_KEY=
META_BASE_URL=
META_MODEL_ID=
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL_ID=
SUPABASE_JWKS_URL=
# Notice → Plan (names only; values never committed). Signing key is required to enable the feature.
ROSINA_PROPOSAL_SIGNING_KEY=
# REQUIRED when the signing key is set: the GraphQL ROUTER URL (e.g. http://127.0.0.1:4012/).
# NO default and NO fallback to ROSINA_MCP_URL — the MCP port is not a GraphQL endpoint; an unset
# value fails Rosina fast at startup rather than serving a broken feature.
ROSINA_GRAPHQL_URL=
ROSINA_NOTICE_SCENARIO_DATE=
# Invites (slim). Image is a labelled fixture unless INVITE_LIVE=1 (live muse-image-1.0, UNVERIFIED —
# reconfirm Meta's image docs first). Extraction + parent authz reuse the Meta provider + ROSINA_GRAPHQL_URL.
INVITE_LIVE=
INVITE_GENERATION_BUDGET=
INVITE_RATE_LIMIT_PER_MIN=
