META_API_KEY=
META_BASE_URL=
META_MODEL_ID=
BASETEN_API_KEY=
BASETEN_BASE_URL=
BASETEN_MODEL_ID=
SUPABASE_JWKS_URL=
# Notice → Plan (names only; values never committed). Signing key is required to enable the feature.
ROSINA_PROPOSAL_SIGNING_KEY=
# REQUIRED when the signing key is set: the GraphQL ROUTER URL (e.g. http://127.0.0.1:4012/).
# NO default and NO fallback to ROSINA_MCP_URL — the MCP port is not a GraphQL endpoint; an unset
# value fails Rosina fast at startup rather than serving a broken feature.
ROSINA_GRAPHQL_URL=
ROSINA_NOTICE_SCENARIO_DATE=
# Invites (slim). Image is a labelled fixture unless INVITE_LIVE=1 (live muse-image-1.0, UNVERIFIED —
# reconfirm Meta's image docs first). Extraction + parent authz reuse the Meta provider + ROSINA_GRAPHQL_URL.
INVITE_LIVE=
INVITE_GENERATION_BUDGET=
INVITE_RATE_LIMIT_PER_MIN=

# Pin it to the fridge (names only; values never committed). Intake is DEFAULT OFF: the web only
# offers it when GET /api/rosina/pin/readiness reports ready, which needs PIN_INTAKE_READY=1 set only
# after an operator verifies the path end to end. PIN_LIVE=1 switches Muse vision (muse-spark-1.3) and
# SAM 3.1 segmentation from offline fixtures to the live Meta Model API; both reuse the Meta provider
# (META_*) + ROSINA_GRAPHQL_URL. SAM is non-blocking by design — if it is down, the photo is placed
# uncropped. PIN_SEGMENT_MODEL/PIN_VISION_MODEL override the model ids (defaults sam-3.1 / muse-spark-1.3).
PIN_INTAKE_READY=
PIN_LIVE=
PIN_MEDIA_DIR=
PIN_VISION_MODEL=
PIN_SEGMENT_MODEL=

# Demo picker + /api/demo/* (login, reset, family) live on 4008 and are OFF unless this is 1.
# Measured 2026-11-02: a stack restarted without it served 4001-4007 and NO 4008, so every demo read
# failed while the subgraphs looked healthy. Set it explicitly for any local/demo launch.
DEMO_LOGIN_ENABLED=1
DEMO_LOGIN_PORT=4008

# Optional: comma-separated BARE https origins allowed to call /api/demo/* cross-origin from a
# browser. Empty (the default) keeps localhost-only behaviour. Validated at startup: wildcards,
# credentials, the opaque "null", non-https schemes and anything with a path/query/fragment are
# refused, and a malformed value stops the demo endpoint rather than widening it.
# This is the API app-origin list only — it is NOT a CSP frame-ancestors / embedding allow-list.
DEMO_ALLOWED_APP_ORIGINS=
