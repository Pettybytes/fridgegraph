{
  "name": "fridgegraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "reset": "tsx src/reset.ts",
    "rosina": "tsx src/rosina/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-secrets.mjs",
    "check:rosina-catalog": "node ops/rosina-catalog-drift.mjs",
    "test:rosina": "node --import tsx --test src/rosina/*.test.ts",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts reset",
    "db:checksum": "tsx scripts/db.ts checksum",
    "verify:station06": "tsx ops/station06-verify.mjs",
    "suite": "node --import tsx ops/run-suite.mjs",
    "db:restore-demo": "tsx scripts/db.ts restore:demo",
    "test:village": "node --import tsx --test src/village/*.test.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@apollo/subgraph": "^2.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^4.21.2",
    "graphql": "^16.9.0",
    "jose": "^6.2.13",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/pg": "^8.11.0"
  }
}
